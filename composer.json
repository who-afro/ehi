{
    "name": "ehi/ehi",
    "type": "project",
    "description": "WHO Regional Menu Of Essential Health Interventions",
    "keywords": [
        "who",
        "disease control interventions",
        "essential health interventions"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-zip": "*",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "blade-ui-kit/blade-icons": "^1.10",
        "blade-ui-kit/blade-zondicons": "^1.7",
        "codeat3/blade-eos-icons": "^1.3",
        "codeat3/blade-iconpark": "^1.2",
        "codeat3/blade-line-awesome-icons": "^1.0",
        "dompdf/dompdf": "^3.1",
        "dyrynda/laravel-model-uuid": "^8.3",
        "filament/filament": "^5.7",
        "flynsarmy/csv-seeder": "^2.0",
        "guzzlehttp/guzzle": "^8.1",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.5",
        "laravel/sanctum": "^4.3",
        "laravel/telescope": "^5.22",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "maatwebsite/excel": "^4.0",
        "owenvoke/blade-fontawesome": "^3.3",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-ignition": "^2.12",
        "spatie/laravel-ray": "^1.29",
        "spatie/laravel-translatable": "^6.14",
        "spatie/laravel-validation-rules": "^3.2",
        "spatie/simple-excel": "^3.10",
        "zanysoft/laravel-zip": "^3.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "laravel-shift/blueprint": "^2.13",
        "laravel/boost": "^2.7",
        "laravel/pao": "^1.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
            "@php artisan telescope:publish",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "@php artisan cache:clear",
            "@php artisan config:clear",
            "@php artisan route:clear"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    }
}
