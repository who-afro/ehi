{
    "name": "ehi/ehi",
    "type": "project",
    "description": "WHO Regional Menu Of Essential Health Interventions",
    "keywords": [
        "who",
        "disease control interventions",
        "essential health interventions"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "blade-ui-kit/blade-heroicons": "^1.3",
        "blade-ui-kit/blade-icons": "^1.2",
        "blade-ui-kit/blade-zondicons": "^1.0",
        "codeat3/blade-eos-icons": "^1.3",
        "codeat3/blade-iconpark": "^1.2",
        "codeat3/blade-line-awesome-icons": "^1.0",
        "dompdf/dompdf": "^1.2",
        "flagstudio/nova-actions-left": "^0.3.0",
        "flynsarmy/csv-seeder": "^2.0",
        "fruitcake/laravel-cors": "^2.0.5",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^9.0",
        "laravel/jetstream": "^2.6",
        "laravel/nova": "~3.0",
        "laravel/sanctum": "^2.14",
        "laravel/telescope": "^4.7",
        "laravel/tinker": "^2.7",
        "livewire/livewire": "^2.0",
        "maatwebsite/excel": "^3.1",
        "owenvoke/blade-fontawesome": "dev-main",
        "spatie/laravel-ray": "^1.29",
        "spatie/laravel-translatable": "^5.2",
        "spatie/nova-translatable": "^3.0",
        "vmitchell85/nova-links": "^1.0",
        "spatie/laravel-ignition": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "fakerphp/faker": "^1.9.1",
        "laravel-shift/blueprint": "dev-l9-compatibility",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10"

    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
            "@php artisan nova:publish",
            "@php artisan telescope:publish"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "@php artisan cache:clear",
            "@php artisan config:clear",
            "@php artisan route:clear"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    }
}
